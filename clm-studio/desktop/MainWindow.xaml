<Window x:Class="ClmStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLM Studio · 音频封装器"
        Width="1120" Height="780" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#74809A"/>
        <SolidColorBrush x:Key="Accent" Color="#5367E8"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF0F8"/>
            <Setter Property="Foreground" Value="#303A55"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F0F2FA"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E8ECFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="CLM STUDIO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="加密音频封装器" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,5,0,0"/>
                <TextBlock Text="整理音轨顺序，加入封面，生成可在手机端播放的 CLM 文件。" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E9EDFF" CornerRadius="14" Padding="14,9">
                <TextBlock Text="CLM 2 · 加密流式播放" FontSize="12" FontWeight="SemiBold" Foreground="#4658C7"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="22" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="音轨列表" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <TextBlock x:Name="TrackCountText" Text="0 首音频" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="AddFiles_Click" Content="＋ 添加音频"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#F6F7FB" CornerRadius="10" Padding="12,9" Margin="0,0,0,12">
                        <TextBlock Text="默认按数字顺序排列 · 拖动条目可调整播放顺序" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </Border>
                    <ListBox x:Name="TrackList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             AllowDrop="True" PreviewMouseLeftButtonDown="TrackList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TrackList_PreviewMouseMove" DragOver="TrackList_DragOver" Drop="TrackList_Drop"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⋮⋮" FontSize="16" Foreground="#98A2B8" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ExtensionLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="Bold" Foreground="#64708A" Background="#EDF0F7" Padding="8,5"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Click="RemoveSelected_Click" Content="移除选中" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Click="ClearTracks_Click" Content="清空列表"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="22" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="专辑封面" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="封面会嵌入 CLM 文件" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" MinHeight="190">
                        <Border x:Name="CoverPlaceholder" Background="#EFF1F8" CornerRadius="18">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="38" Foreground="#A0A8BC" HorizontalAlignment="Center"/>
                                <TextBlock Text="尚未选择封面" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Image x:Name="CoverPreview" Stretch="UniformToFill" Visibility="Collapsed" ClipToBounds="True"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,20">
                        <Button Style="{StaticResource SecondaryButton}" Click="ChooseCover_Click" Content="选择封面图片" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="CoverNameText" Text="支持 JPEG、PNG、WebP" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="2,8,2,0"/>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#F6F7FB" CornerRadius="14" Padding="14">
                        <StackPanel>
                            <Label Content="_内容口令" Target="{Binding ElementName=ContentPassword}" Padding="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                            <PasswordBox x:Name="ContentPassword" MinHeight="28" Margin="0,7,0,0" AutomationProperties.Name="内容口令"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="添加音频、选择封面并输入内容口令。" FontSize="12" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="支持 MP3、M4A、AAC、WAV、FLAC、OGG、OPUS、WMA 等常见音频" FontSize="11" Foreground="#9AA3B5" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CreateButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="CreateClm_Click" Content="生成 CLM 文件  →"/>
        </Grid>
    </Grid>
</Window>
